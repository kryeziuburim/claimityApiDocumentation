{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claimity/api/schemas/claims/special-claim.schema.json",
  "title": "Special Claim Payload",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "policyNumber",
    "claimInsurance",
    "claimType",
    "machineCategory",
    "machineType",
    "insured",
    "location",
    "incidentDate",
    "damageDescription",
    "estimatedAmount",
    "estimatedCurrency",
    "inspectionType"
  ],
  "$defs": {
    "optionalDate": {
      "$comment": "Optional ISO date. Empty string and null both mean 'not set'. Deliberately NOT modelled as oneOf[format:date, maxLength:0, null]: `format` is annotation-only (RequireFormatValidation is off), so an empty string would match two branches and oneOf would fail.",
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01]))?$"
    },
    "requiredDate": {
      "$comment": "Mandatory ISO date. `pattern` (not `format`) does the asserting; see optionalDate.",
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$"
    }
  },
  "properties": {
    "policyNumber": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "examples": [
        "POL-2026-00123"
      ]
    },
    "claimInsurance": {
      "type": "string",
      "enum": [
        "liability",
        "partial",
        "comprehensive"
      ]
    },
    "claimType": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "examples": [
        "Operational damage"
      ]
    },
    "machineCategory": {
      "type": "string",
      "enum": [
        "rail_vehicle",
        "aircraft",
        "land_machine"
      ]
    },
    "machineType": {
      "type": "string",
      "enum": [
        "gondola",
        "train",
        "tram",
        "rack_railway",
        "glider",
        "powered_aircraft",
        "drone",
        "tractor",
        "trailer",
        "harvester",
        "stationary_machine"
      ]
    },
    "insured": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "Max Sample"
          ]
        },
        "address": {
          "type": "string",
          "examples": [
            "Sample Street 1"
          ]
        },
        "postalCode": {
          "type": "string",
          "examples": [
            "8001"
          ]
        },
        "city": {
          "type": "string",
          "examples": [
            "Zurich"
          ]
        },
        "phone": {
          "type": "string",
          "examples": [
            "+41 44 123 45 67"
          ]
        },
        "email": {
          "type": "string",
          "examples": [
            "max.sample@example.ch"
          ]
        },
        "note": {
          "type": "string",
          "examples": [
            "Reachable after 2 pm"
          ]
        },
        "deductible": {
          "type": "string",
          "examples": [
            "300"
          ]
        },
        "licensePlate": {
          "type": "string",
          "examples": [
            "ZH 123456"
          ]
        },
        "vin": {
          "type": "string",
          "examples": [
            "WVWZZZ1KZAW123456"
          ]
        },
        "carMake": {
          "type": "string",
          "examples": [
            "VW"
          ]
        },
        "carModel": {
          "type": "string",
          "examples": [
            "Golf"
          ]
        },
        "firstRegistration": {
          "$ref": "#/$defs/optionalDate",
          "examples": [
            "2020-06-15"
          ]
        }
      }
    },
    "counterparty": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "Erika Example"
          ]
        },
        "address": {
          "type": "string",
          "examples": [
            "Example Road 2"
          ]
        },
        "postalCode": {
          "type": "string",
          "examples": [
            "3011"
          ]
        },
        "city": {
          "type": "string",
          "examples": [
            "Bern"
          ]
        },
        "phone": {
          "type": "string",
          "examples": [
            "+41 31 987 65 43"
          ]
        },
        "email": {
          "type": "string",
          "examples": [
            "erika.example@example.ch"
          ]
        },
        "note": {
          "type": "string",
          "examples": [
            "Represented by a lawyer"
          ]
        },
        "licensePlate": {
          "type": "string",
          "examples": [
            ""
          ]
        },
        "vin": {
          "type": "string",
          "examples": [
            ""
          ]
        },
        "make": {
          "type": "string",
          "examples": [
            "Stadler"
          ]
        },
        "model": {
          "type": "string",
          "examples": [
            "FLIRT"
          ]
        },
        "firstRegistration": {
          "$ref": "#/$defs/optionalDate",
          "examples": [
            "2015-08-01"
          ]
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "address": {
          "type": "string",
          "examples": [
            "Sample Street 1"
          ]
        },
        "postalCode": {
          "type": "string",
          "examples": [
            "8001"
          ]
        },
        "city": {
          "type": "string",
          "minLength": 1,
          "examples": [
            "Zurich"
          ]
        }
      },
      "required": [
        "city"
      ]
    },
    "incidentDate": {
      "$ref": "#/$defs/requiredDate",
      "examples": [
        "2026-01-15"
      ]
    },
    "damageDescription": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "examples": [
        "Gearbox damage after overheating"
      ]
    },
    "estimatedAmount": {
      "$comment": "Non-negative. The string branch deliberately has no leading minus.",
      "oneOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^\\d+(\\.\\d+)?$"
        }
      ],
      "examples": [
        "2500"
      ]
    },
    "estimatedCurrency": {
      "type": "string",
      "enum": [
        "CHF",
        "EUR",
        "USD"
      ]
    },
    "inspectionType": {
      "$comment": "The `examples` entry keeps the docs' generated sample payload valid: the sample fixes machineCategory to its first enum value (rail_vehicle), whose branch only allows onsite/estimate_review/invoice_review — the first entry of THIS enum (workshop) would contradict it.",
      "type": "string",
      "enum": [
        "workshop",
        "private",
        "onsite",
        "estimate_review",
        "invoice_review"
      ],
      "examples": [
        "onsite"
      ]
    },
    "workshop": {
      "$comment": "No country here.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "Sample Garage Ltd"
          ]
        },
        "phone": {
          "type": "string",
          "examples": [
            "+41 31 111 22 33"
          ]
        },
        "email": {
          "type": "string",
          "examples": [
            "info@sample-garage.ch"
          ]
        },
        "address": {
          "type": "string",
          "examples": [
            "Workshop Road 5"
          ]
        },
        "postalCode": {
          "type": "string",
          "examples": [
            "3000"
          ]
        },
        "city": {
          "type": "string",
          "examples": [
            "Bern"
          ]
        }
      }
    },
    "inspectionContact": {
      "$comment": "No country here.",
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "name": {
          "type": "string",
          "examples": [
            "Henry Contact"
          ]
        },
        "phone": {
          "type": "string",
          "examples": [
            "+41 79 555 66 77"
          ]
        },
        "email": {
          "type": "string",
          "examples": [
            "henry.contact@example.ch"
          ]
        },
        "address": {
          "type": "string",
          "examples": [
            "Contact Lane 3"
          ]
        },
        "postalCode": {
          "type": "string",
          "examples": [
            "8400"
          ]
        },
        "city": {
          "type": "string",
          "examples": [
            "Winterthur"
          ]
        }
      }
    },
    "inspectionDate": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])$",
      "$comment": "Example deliberately far in the future: claims:validate rejects inspection dates in the past, and the docs' Test tab submits this value as-is.",
      "examples": [
        "2030-01-15"
      ]
    },
    "remarks": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000,
      "examples": [
        "Inspection preferred in the morning."
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "machineCategory": {
            "enum": [
              "rail_vehicle",
              "aircraft"
            ]
          }
        },
        "required": [
          "machineCategory"
        ]
      },
      "then": {
        "properties": {
          "claimInsurance": {
            "const": "liability"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "machineCategory": {
            "const": "rail_vehicle"
          }
        },
        "required": [
          "machineCategory"
        ]
      },
      "then": {
        "properties": {
          "machineType": {
            "enum": [
              "gondola",
              "train",
              "tram",
              "rack_railway"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "machineCategory": {
            "const": "aircraft"
          }
        },
        "required": [
          "machineCategory"
        ]
      },
      "then": {
        "properties": {
          "machineType": {
            "enum": [
              "glider",
              "powered_aircraft",
              "drone"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "machineCategory": {
            "const": "land_machine"
          }
        },
        "required": [
          "machineCategory"
        ]
      },
      "then": {
        "properties": {
          "machineType": {
            "enum": [
              "tractor",
              "trailer",
              "harvester",
              "stationary_machine"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "machineCategory": {
            "const": "land_machine"
          }
        },
        "required": [
          "machineCategory"
        ]
      },
      "then": {
        "properties": {
          "inspectionType": {
            "enum": [
              "workshop",
              "private",
              "estimate_review",
              "invoice_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "machineCategory": {
            "enum": [
              "rail_vehicle",
              "aircraft"
            ]
          }
        },
        "required": [
          "machineCategory"
        ]
      },
      "then": {
        "properties": {
          "inspectionType": {
            "enum": [
              "onsite",
              "estimate_review",
              "invoice_review"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claimInsurance": {
            "const": "liability"
          }
        },
        "required": [
          "claimInsurance"
        ]
      },
      "then": {
        "required": [
          "counterparty"
        ],
        "properties": {
          "counterparty": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "phone": {
                "type": "string",
                "minLength": 1
              },
              "city": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "phone",
              "city"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claimInsurance": {
            "enum": [
              "partial",
              "comprehensive"
            ]
          }
        },
        "required": [
          "claimInsurance"
        ]
      },
      "then": {
        "required": [
          "insured"
        ],
        "properties": {
          "insured": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "phone": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": "string",
                "minLength": 1
              },
              "postalCode": {
                "type": "string",
                "minLength": 1
              },
              "city": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "name",
              "phone",
              "address",
              "postalCode",
              "city"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "machineCategory": {
            "enum": [
              "aircraft",
              "land_machine"
            ]
          },
          "claimInsurance": {
            "const": "liability"
          }
        },
        "required": [
          "machineCategory",
          "claimInsurance"
        ]
      },
      "then": {
        "required": [
          "counterparty"
        ],
        "properties": {
          "counterparty": {
            "type": "object",
            "properties": {
              "make": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "make"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "machineCategory": {
            "const": "land_machine"
          },
          "claimInsurance": {
            "enum": [
              "partial",
              "comprehensive"
            ]
          }
        },
        "required": [
          "machineCategory",
          "claimInsurance"
        ]
      },
      "then": {
        "required": [
          "insured"
        ],
        "properties": {
          "insured": {
            "type": "object",
            "properties": {
              "carMake": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "carMake"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inspectionType": {
            "const": "workshop"
          }
        },
        "required": [
          "inspectionType"
        ]
      },
      "then": {
        "required": [
          "inspectionDate",
          "workshop"
        ],
        "properties": {
          "inspectionDate": {
            "$ref": "#/$defs/requiredDate"
          },
          "workshop": {
            "type": "object",
            "required": [
              "name",
              "phone",
              "city",
              "postalCode"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inspectionType": {
            "enum": [
              "estimate_review",
              "invoice_review"
            ]
          }
        },
        "required": [
          "inspectionType"
        ]
      },
      "then": {
        "required": [
          "workshop"
        ],
        "properties": {
          "workshop": {
            "type": "object",
            "required": [
              "name",
              "phone"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "inspectionType": {
            "enum": [
              "private",
              "onsite"
            ]
          }
        },
        "required": [
          "inspectionType"
        ]
      },
      "then": {
        "required": [
          "inspectionDate",
          "inspectionContact"
        ],
        "properties": {
          "inspectionDate": {
            "$ref": "#/$defs/requiredDate"
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "inspectionContact"
        ]
      },
      "then": {
        "properties": {
          "inspectionContact": {
            "type": "object",
            "required": [
              "name",
              "address",
              "postalCode",
              "city",
              "phone"
            ]
          }
        }
      }
    }
  ]
}
