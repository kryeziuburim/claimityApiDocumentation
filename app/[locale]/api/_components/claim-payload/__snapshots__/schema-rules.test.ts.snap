exports[`appraiser schema > rules and format hints (de) 1`] = `
{
  "formatHints": [
    {
      "description": "Datum im ISO-Format YYYY-MM-DD",
      "path": "payloadJson.incidentDate",
    },
    {
      "description": "Numerischer String ohne Vorzeichen (optional Nachkommastellen, Punkt als Trenner)",
      "path": "payloadJson.estimatedAmount",
    },
    {
      "description": "Datum im ISO-Format YYYY-MM-DD",
      "path": "payloadJson.inspectionDate",
    },
  ],
  "ruleGroups": [
    {
      "key": "claimInsurance",
      "rules": [
        {
          "condition": "\`claimInsurance\` den Wert \`liability\` hat",
          "details": [
            "Pflichtfelder: \`counterparty\`",
            "\`insured\` benötigt \`name\`",
            "\`counterparty\` benötigt \`name\`, \`phone\`, \`city\`",
          ],
          "type": "if",
        },
        {
          "condition": "\`claimInsurance\` den Wert \`own\` hat",
          "details": [
            "\`insured\` benötigt \`name\`, \`phone\`, \`city\`",
          ],
          "type": "if",
        },
      ],
      "title": "Abhängig vom Feld \`claimInsurance\`",
    },
    {
      "key": "inspectionType",
      "rules": [
        {
          "condition": "\`inspectionType\` den Wert \`onsite\` hat",
          "details": [
            "Pflichtfelder: \`inspectionDate\`, \`inspectionContact\`",
            "\`inspectionContact\` benötigt \`name\`, \`postalCode\`, \`city\`, \`phone\`, \`country\`",
            "\`inspectionContact.country\` muss einer der Werte \`CH\`, \`DE\`, \`AT\`, \`FR\`, \`IT\`, \`LI\` sein",
          ],
          "type": "if",
        },
      ],
      "title": "Abhängig vom Feld \`inspectionType\`",
    },
    {
      "key": "inspectionContact",
      "rules": [
        {
          "condition": "das Feld \`inspectionContact\` vorhanden ist",
          "details": [
            "\`inspectionContact\` benötigt \`name\`, \`postalCode\`, \`city\`, \`phone\`, \`country\`",
            "\`inspectionContact.country\` muss einer der Werte \`CH\`, \`DE\`, \`AT\`, \`FR\`, \`IT\`, \`LI\` sein",
          ],
          "type": "if",
        },
      ],
      "title": "Abhängig vom Feld \`inspectionContact\`",
    },
  ],
}
`;

