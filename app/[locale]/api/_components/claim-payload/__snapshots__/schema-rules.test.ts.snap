      "description": "Numerischer String ohne Vorzeichen (optional Nachkommastellen, Punkt als Trenner)",
      "path": "payloadJson.estimatedAmount",
    },
    {
      "description": "Datum im ISO-Format YYYY-MM-DD",
      "path": "payloadJson.inspectionDate",
    },
  ],
  "ruleGroups": [
    {
      "key": "claimInsurance",
      "rules": [
        {
          "condition": "\`claimInsurance\` den Wert \`liability\` hat",
          "details": [
            "Pflichtfelder: \`counterparty\`",
            "\`counterparty\` benötigt \`name\`, \`phone\`, \`licensePlate\`, \`city\`, \`carMake\`",
          ],
          "type": "if",
        },
        {
          "condition": "\`claimInsurance\` einen der Werte \`partial\`, \`comprehensive\` hat",
          "details": [
            "Pflichtfelder: \`insured\`",
            "\`insured\` benötigt \`name\`, \`phone\`, \`licensePlate\`, \`address\`, \`postalCode\`, \`city\`, \`carMake\`",
          ],
          "type": "if",
        },
        {
          "condition": "\`claimInsurance\` den Wert \`partial\` hat",
          "details": [
            "\`claimType\` muss einer der Werte \`fire\`, \`natural_hazard\`, \`hail_damage\`, \`snow_slide\`, \`theft\`, \`animal_collision\`, \`marten_damage\`, \`glass_breakage\`, \`vandalism\`, \`assistance\`, \`falling_objects\`, \`parking_damage\` sein",
          ],
          "type": "if",
        },
      ],
      "title": "Abhängig vom Feld \`claimInsurance\`",
    },
    {
      "key": "inspectionType",
      "rules": [
        {
          "condition": "\`inspectionType\` den Wert \`workshop\` hat",
          "details": [
            "Pflichtfelder: \`inspectionDate\`, \`workshop\`",
            "\`workshop\` benötigt \`name\`, \`phone\`, \`city\`, \`postalCode\`, \`country\`",
            "\`workshop.country\` muss einer der Werte \`CH\`, \`DE\`, \`AT\`, \`FR\`, \`IT\`, \`LI\` sein",
          ],
          "type": "if",
        },
        {
          "condition": "\`inspectionType\` einen der Werte \`estimate_review\`, \`invoice_review\` hat",
          "details": [
            "Pflichtfelder: \`workshop\`",
            "\`workshop\` benötigt \`name\`, \`phone\`",
          ],
          "type": "if",
        },
        {
          "condition": "\`inspectionType\` einen der Werte \`private\`, \`live_expertise\` hat",
          "details": [
            "Pflichtfelder: \`inspectionDate\`, \`inspectionContact\`",
          ],
          "type": "if",
        },
      ],
      "title": "Abhängig vom Feld \`inspectionType\`",
    },
    {
      "key": "inspectionContact",
      "rules": [
        {
          "condition": "das Feld \`inspectionContact\` vorhanden ist",
          "details": [
            "\`inspectionContact\` benötigt \`name\`, \`address\`, \`postalCode\`, \`city\`, \`phone\`, \`country\`",
            "\`inspectionContact.country\` muss einer der Werte \`CH\`, \`DE\`, \`AT\`, \`FR\`, \`IT\`, \`LI\` sein",
          ],
          "type": "if",
        },
      ],
      "title": "Abhängig vom Feld \`inspectionContact\`",
    },
  ],
}
